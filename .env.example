# API keys, read from the environment only. Copy this file to .env (which git ignores),
# fill in the keys you need, and load it into your shell before running a command:
#   set -a; source .env; set +a
# The harness never reads .env itself, and never logs or prints a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
